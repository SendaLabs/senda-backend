# Servidor
PORT=3000
NODE_ENV=development

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v22.0
VERIFY_TOKEN=senda-verify-token
# App Secret de Meta (firma X-Hub-Signature-256 del webhook). Obligatorio en POST.
WHATSAPP_APP_SECRET=
# URL pública del backend (Render setea RENDER_EXTERNAL_URL solo). Sirve el video de bienvenida.
PUBLIC_BASE_URL=
# true = no manda el video de hola (el menú sí). Útil si Meta rechaza el mp4.
WELCOME_SKIP_VIDEO=

# Stellar / Soroban
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_CONTRACT_ID=
STELLAR_PUBLIC_KEY=

# USDC (Stellar Asset Contract / SAC)
USDC_SAC_CONTRACT_ID=CDT2MY3QNV2RT2XULQWWXX2JELUWRWNXNKONCYG5MTIGZM7G5S2QNNGB
USDC_CODE=USDC
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Cuenta operativa (nunca commitear secretos reales)
STELLAR_SECRET_KEY=
# Tesorería pooled (yield Blend). Si falta, usa STELLAR_SECRET_KEY.
STELLAR_TREASURY_SECRET_KEY=

# Custodia invisible (SEP-30). Obligatorio y distinto de STELLAR_SECRET_KEY.
CUSTODY_MASTER_SECRET=
# Cifrado en reposo de códigos de retiro y wallets legado. Distinto de los otros dos.
FILE_VAULT_SECRET=

# Vault de retiro en efectivo. Obligatorio: cuenta G… distinta de la operativa.
STELLAR_OFFRAMP_PUBLIC_KEY=

# Transcripción de notas de voz (OpenAI Whisper)
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Privy — wallet embedded self-custodial. El alta es UNA vez en /web-setup.
# El bot no crea la wallet. El usuario entra por SMS (mismo WhatsApp) y delega
# el session signer de Senda con la policy de gasto (500 USDC/tx, 2000/día).
USE_PRIVY_WALLETS=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Key quorum ID + authorization private key del session signer (dashboard Privy).
PRIVY_SESSION_SIGNER_ID=
PRIVY_SESSION_SIGNER_PRIVATE_KEY=
# Policy ID del dashboard que copia SENDA_MAX_USDC_PER_TRANSACTION / _PER_DAY.
PRIVY_SPEND_POLICY_ID=
# Mini sitio Next.js (Tarea 9). Origin para CORS y URL pública del alta.
WEB_SETUP_PUBLIC_URL=http://localhost:3001
WEB_SETUP_ORIGIN=http://localhost:3001
# Número de Senda para el botón «volver a WhatsApp» (wa.me), sin + ni espacios.
WHATSAPP_CLICK_TO_CHAT=

# Persistencia (Prisma opcional; el bot usa data/senda-db.json)
DATABASE_URL=file:../data/senda.db

# SEP-24 retiro a Mercado Pago (ancla de test)
SEP24_HOME_DOMAIN=testanchor.stellar.org

# Blend Testnet (rendimiento USDC)
BLEND_POOL_ID=CCEBVDYM32YNYCVNRXQKDFFPISJJCV557CDZEIRBEE4NCV4KHPQ44HGF
BLEND_USDC_SAC_ID=
# Bloquea depósitos de yield si la utilización del pool supera este ratio (0-1)
BLEND_MAX_UTILIZATION=0.85
