{
  "name": "senda-backend",
  "version": "0.1.0",
  "description": "Backend de Senda: WhatsApp Cloud API + Stellar/Soroban",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "contract:build": "stellar contract build --manifest-path contracts/Cargo.toml",
    "contract:deploy": "node scripts/deploy-contract.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "stellar",
    "soroban",
    "whatsapp",
    "web3"
  ],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@stellar/stellar-sdk": "^17.0.1",
    "axios": "^1.12.2",
    "dotenv": "^17.2.2",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.18.6",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
