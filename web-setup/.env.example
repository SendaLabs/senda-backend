# Privy (client)
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_SESSION_SIGNER_ID=
# Optional spend policy from Privy dashboard
NEXT_PUBLIC_PRIVY_SPEND_POLICY_ID=

# Backend API for the Next server proxy. Browser always calls same-origin /api/*
# (Next proxies to this URL). NEXT_PUBLIC_SENDA_API_URL is only a server-side
# fallback for that proxy, not a client base URL.
SENDA_API_URL=http://localhost:3000
NEXT_PUBLIC_SENDA_API_URL=

# WhatsApp click-to-chat (digits only, no +)
NEXT_PUBLIC_WHATSAPP_CLICK_TO_CHAT=
